<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove Hospital Record"
        android:textColor="#C62828"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the exact hospital name stored in the offline SQLite registry:"
        android:textColor="#212121"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Hospital Name"
        android:textColor="#212121"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTargetDeleteName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:hint="e.g. KEM Hospital"
        android:textColor="#111111"
        android:textColorHint="#757575"
        android:paddingHorizontal="14dp"
        android:inputType="textCapWords"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSubmitDelete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#C62828"
        android:text="Delete From Directory"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

</LinearLayout>