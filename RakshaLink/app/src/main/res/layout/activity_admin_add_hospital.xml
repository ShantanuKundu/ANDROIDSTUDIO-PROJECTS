<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Hospital Facility"
            android:textColor="#1B5E20"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital Name"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="Enter hospital name"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="textCapWords"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area / Suburb"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddArea"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="e.g. Dadar, Kurla, Bandra"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="textCapWords"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desk Contact Number"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="e.g. 022-24107000"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="phone"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latitude"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddLat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="e.g. 19.0178"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Longitude"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddLng"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="e.g. 72.8478"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAddRating"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="1.0 - 5.0"
            android:textColor="#111111"
            android:textColorHint="#757575"
            android:paddingHorizontal="14dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbAddIcu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24/7 Active ICU Facility Available"
            android:textColor="#212121"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSubmitAdd"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#2E7D32"
            android:text="Save Hospital to Database"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>