<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mumbai Hospital Directory"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#C62828"
        android:layout_marginBottom="12dp"/>

    <!-- Search by Area / Name -->
    <EditText
        android:id="@+id/etSearchArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by Area (e.g., Parel, Bandra, Thane)"
        android:inputType="text"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="10dp"/>

    <!-- ICU Filter Checkbox -->
    <CheckBox
        android:id="@+id/cbIcuOnly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show 24/7 ICU Facilities Only"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginBottom="12dp"/>

    <!-- Dynamic Container for Hospital Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutHospitalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>